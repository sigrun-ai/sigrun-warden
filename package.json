{
	"name": "@sigrun/warden",
	"version": "0.2.0",
	"description": "Guardrail extension for sigrun: action classification, holds, and judge-backed confirmations (pi-warden port)",
	"type": "module",
	"engines": {
		"node": ">=22.19.0"
	},
	"main": "dist/index.js",
	"types": "dist/index.d.ts",
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"default": "./dist/index.js"
		}
	},
	"files": [
		"dist",
		"CHANGELOG.md"
	],
	"scripts": {
		"test": "node scripts/check-manifest.mjs --expect-name @sigrun/warden && vitest run",
		"typecheck": "tsc --noEmit",
		"build": "tsc -p tsconfig.build.json",
		"prepare": "npm run build"
	},
	"peerDependencies": {
		"@sigrun/sigrun": ">=0.15.0",
		"@earendil-works/chord": "~1.5.0",
		"@earendil-works/pi-ai": "~1.5.0",
		"@earendil-works/pi-durable": "~1.5.0",
		"@sigrun/shared": "0.8.0 || 0.9.0 || 0.10.0 || 0.10.1 || 0.11.0 || 0.12.0 || 0.13.0 || 0.14.0 || 0.15.0",
		"typebox": "1.3.27"
	},
	"dependencies": {
		"pi-warden": "^2.6.1",
		"pi-typesafe": "^0.14.0"
	},
	"devDependencies": {
		"@earendil-works/chord": "1.5.0",
		"@earendil-works/pi-ai": "1.5.0",
		"@earendil-works/pi-durable": "1.5.0",
		"@sigrun/shared": "file:../sigrun/shared",
		"@sigrun/sigrun": "file:../sigrun",
		"@types/node": "^26.6.4",
		"tsx": "^4.23.15",
		"typescript": "^7.0.2",
		"vitest": "^5.0.3",
		"typebox": "1.3.27"
	},
	"license": "MIT",
	"repository": {
		"type": "github",
		"url": "git+https://github.com/sigrun-ai/sigrun-warden.git"
	},
	"bugs": {
		"url": "https://github.com/sigrun-ai/sigrun-warden/issues"
	},
	"homepage": "https://github.com/sigrun-ai/sigrun-warden#readme",
	"publishConfig": {
		"access": "public",
		"provenance": true
	}
}
